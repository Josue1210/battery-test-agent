<Window x:Class="BatteryTest.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BatteryTest.Agent"
        Title="Battery Test — Agente"
        Height="820" Width="780" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:InfoRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="#5F6368" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#202124" />
            </Grid>
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E2E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Battery Test" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Mide cuánto dura tu batería con una carga de trabajo simulada. Nada empieza hasta que pulses «Iniciar test», y por ahora no se envía ningún dato." />
        </StackPanel>

        <!-- Barra inferior: el botón de detener está aquí para que siempre esté visible. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button x:Name="StopButton" DockPanel.Dock="Left" Content="Detener test" Padding="20,6" Margin="0,0,12,0"
                    Background="#C5221F" Foreground="White" FontWeight="SemiBold" Visibility="Collapsed" Click="OnStopClick" />
            <Button DockPanel.Dock="Right" Content="Actualizar" Padding="16,6" Click="OnRefreshClick" />
            <Button DockPanel.Dock="Right" Content="Copiar reporte" Padding="16,6" Margin="0,0,8,0" Click="OnCopyReportClick"
                    ToolTip="Copia todos los datos como texto al portapapeles" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#5F6368" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Test de batería" Style="{StaticResource CardTitle}" />

                        <!-- Configuración -->
                        <StackPanel x:Name="SetupPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Perfil de carga" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ProfileBox" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,3"
                                          DisplayMemberPath="Name" SelectionChanged="OnSetupChanged" />
                                <TextBlock Grid.Row="1" Text="Detener al llegar a" Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="MinPercentBox" Text="5" Style="{StaticResource NumberBox}" TextChanged="OnSetupChanged" />
                                    <TextBlock Text="% de batería" Style="{StaticResource FieldLabel}" Margin="8,3,0,3" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ProfileDescription" Style="{StaticResource Hint}" Margin="0,4,0,4" />

                            <Grid x:Name="CustomPanel" Visibility="Collapsed" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="CPU en ráfaga (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CustomBurstCpu" Grid.Column="1" Text="60" Style="{StaticResource NumberBox}" TextChanged="OnSetupChanged" />
                                <TextBlock Grid.Column="2" Text="Duración de ráfaga (s)" Style="{StaticResource FieldLabel}" Margin="24,3,8,3" />
                                <TextBox x:Name="CustomBurstSeconds" Grid.Column="3" Text="10" Style="{StaticResource NumberBox}" TextChanged="OnSetupChanged" />
                                <TextBlock Grid.Row="1" Text="CPU en reposo (%)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CustomRestCpu" Grid.Row="1" Grid.Column="1" Text="10" Style="{StaticResource NumberBox}" TextChanged="OnSetupChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Duración de reposo (s)" Style="{StaticResource FieldLabel}" Margin="24,3,8,3" />
                                <TextBox x:Name="CustomRestSeconds" Grid.Row="1" Grid.Column="3" Text="10" Style="{StaticResource NumberBox}" TextChanged="OnSetupChanged" />
                                <TextBlock Grid.Row="2" Text="Memoria (MB)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CustomMemory" Grid.Row="2" Grid.Column="1" Text="512" Style="{StaticResource NumberBox}" TextChanged="OnSetupChanged" />
                            </Grid>

                            <TextBlock Text="Antes de empezar, confirma:" FontWeight="SemiBold" Margin="0,8,0,2" />
                            <CheckBox x:Name="CheckApps" Content="Cerré los programas que no necesito para el test" Click="OnSetupChanged" />
                            <CheckBox x:Name="CheckRadios" Content="El Wi-Fi está conectado y el Bluetooth apagado" Click="OnSetupChanged" />
                            <CheckBox x:Name="CheckPeripherals" Content="Desconecté discos, teléfonos y otros periféricos USB" Click="OnSetupChanged" />
                            <CheckBox x:Name="CheckRisk" Click="OnSetupChanged">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Entiendo que el test calienta el equipo, descarga la batería casi por completo y puede durar varias horas. Lo hago bajo mi responsabilidad." />
                            </CheckBox>

                            <TextBlock x:Name="WarningsText" Foreground="#B06000" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Durante el test el agente fija el brillo de la pantalla al 50 % y luego restaura el tuyo, evita que el equipo se suspenda y escribe un archivo temporal que borra al terminar. Se detiene solo si conectas el cargador o la batería llega al mínimo." />
                            <Button x:Name="StartButton" Content="Iniciar test" IsEnabled="False" HorizontalAlignment="Left"
                                    Padding="20,8" Margin="0,10,0,0" FontWeight="SemiBold" Click="OnStartClick" />
                        </StackPanel>

                        <!-- Test en curso -->
                        <StackPanel x:Name="RunningPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Test en curso. Deja la laptop sin tocar y con esta ventana abierta. Puedes detenerlo cuando quieras con el botón rojo de abajo." />
                            <ItemsControl x:Name="TestStatusList" ItemTemplate="{StaticResource RowTemplate}" />
                        </StackPanel>

                        <!-- Resultado -->
                        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ResultTitle" Text="Resultado del test" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl x:Name="ResultList" ItemTemplate="{StaticResource RowTemplate}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Nuevo test" Padding="16,6" Click="OnNewTestClick" />
                                <Button Content="Abrir carpeta de resultados" Padding="16,6" Margin="8,0,0,0" Click="OnOpenFolderClick" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Batería" Style="{StaticResource CardTitle}" />
                        <ItemsControl x:Name="BatteryList" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Energía" Style="{StaticResource CardTitle}" />
                        <ItemsControl x:Name="PowerList" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CPU en vivo" Style="{StaticResource CardTitle}" />
                        <ItemsControl x:Name="CpuList" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Equipo" Style="{StaticResource CardTitle}" />
                        <ItemsControl x:Name="HardwareList" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
